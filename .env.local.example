NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# CSV import only — never expose in the browser (Settings → API → service_role)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Production sitemap/robots (optional locally)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# For scripts/apply-sql.mjs only (Database → Connection string URI). Do not commit real values.
SUPABASE_DB_URL=postgresql://postgres.[ref]:[YOUR-DB-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres
